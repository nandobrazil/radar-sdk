{
  "name": "@oconde/radar",
  "version": "0.2.0",
  "description": "SDK do Radar para Node.js, NestJS, Express e SvelteKit: logs, erros com trecho de c\u00f3digo, requisi\u00e7\u00f5es, tarefas agendadas e erros do navegador.",
  "license": "MIT",
  "author": "Fernando Conde <me@oconde.dev>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandobrazil/radar-sdk.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "radar-sourcemaps": "./dist/bin/radar-sourcemaps.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      }
    },
    "./protocol": {
      "import": {
        "types": "./dist/protocol/index.d.ts",
        "default": "./dist/protocol/index.js"
      },
      "require": {
        "types": "./dist/protocol/index.d.cts",
        "default": "./dist/protocol/index.cjs"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/sveltekit/index.d.ts",
        "default": "./dist/sveltekit/index.js"
      },
      "require": {
        "types": "./dist/sveltekit/index.d.cts",
        "default": "./dist/sveltekit/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "require": {
        "types": "./dist/browser/index.d.cts",
        "default": "./dist/browser/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nest": [
        "./dist/nest/index.d.cts"
      ],
      "protocol": [
        "./dist/protocol/index.d.cts"
      ],
      "sveltekit": [
        "./dist/sveltekit/index.d.cts"
      ],
      "browser": [
        "./dist/browser/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:nest10": "bash scripts/smoke-nest10.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "rxjs": ">=7",
    "@sveltejs/kit": ">=2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@sveltejs/kit": "^2.70.3",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
